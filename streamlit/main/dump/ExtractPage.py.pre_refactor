import streamlit as st
import os
import datetime
import pandas as pd
from plugin.postgre.QueryBuilder import Engine
from plugin.sheets.UploadSheets import sheetdrive


engine = Engine()
sheetdrive = sheetdrive()

@st.cache_data(ttl=300)
def get_tables():
    return engine.get_all_tables()

@st.cache_data(ttl=300)
def get_columns(table_name):
    return engine.get_table_columns(table_name)
 
tables = get_tables()

if not tables:
    try:
        engine.ping()
    except Exception as e:
        st.error(f"Failed to connect to database: {e}")
        st.stop()

def init_session_state():
    """Initialize all session state variables with a clean slate."""
    defaults = {
        "filters":[],
        "db_select":None
    }
    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value

def extract_page():

    st.title("📊 Data Extractor", anchor="center")

    init_session_state()

    # 1. SELECT TABLE
    table_name = st.selectbox("Database Table", tables, placeholder="Select Table",key="db_select")

    if table_name:
        columns_dict = get_columns(table_name)
        column_names = list(columns_dict.keys())

        if len(column_names)>0: 
            st.toast(f"Total Columns {len(column_names)}, Found!", icon="✅")
        else:
            st.error(f"Failed to fetch columns")
        
        # 2. DATE FILTER
        st.markdown("**Filter by Date (Optional)**")
        # Filter columns that might be dates based on their postgres data type
        date_cols = [c for c, t in columns_dict.items() if 'date' in t.lower() or 'time' in t.lower()]
        
        if date_cols:
            disabled = False
        else:
            disabled = True

        d_col1, d_col2, d_col3 = st.columns(3)
        with d_col1:
            date_column = st.selectbox("Date Column", ["None"] + date_cols)
        with d_col2:
            start_date = st.date_input("Start Date", value=datetime.date.today() - datetime.timedelta(days=30),disabled=disabled)
        with d_col3:
            end_date = st.date_input("End Date", value=datetime.date.today(), disabled=disabled)
            
        # 3. DYNAMIC FILTERS
        st.markdown("**Filter by Columns (Optional)**")
        
        # Button to add a new filter
        if st.button("➕ Add Filter / WHERE Statement"):
            st.session_state.filters.append({"column": column_names[0], "operator": "=", "value": ""})
            # Rerun to show the new filter line
            st.rerun()
            
        filters_to_remove = []
        updated_conditions = []
        repr_conditions = []
        
        # Display each filter
        for i, _filter in enumerate(st.session_state.filters):
            f_col1, f_col2, f_col3, f_col4 = st.columns([3, 0.8, 4, 0.5])
            
            with f_col1:
                # Prevent ValueError if the previously selected column is no longer in this table
                idx_col = column_names.index(_filter['column']) if _filter['column'] in column_names else 0
                sel_col = st.selectbox(f"Column {i+1}", column_names, index=idx_col, key=f"col_{i}")
                col_type = columns_dict.get(sel_col, 'text')
                
            with f_col2:
                # Determine operators based on type
                if 'char' in col_type or 'text' in col_type:
                    ops = ['=', '!=', 'LIKE', 'ILIKE', 'IN']
                elif 'int' in col_type or 'numeric' in col_type or 'real' in col_type or 'float' in col_type:
                    ops = ['=', '!=', '>', '<', '>=', '<=']
                else:
                    ops = ['=', '!=']
                    
                # Keep previous operator if valid for new type, else default
                current_op = _filter['operator'] if _filter['operator'] in ops else ops[0]
                sel_op = st.selectbox(f"Operator", ops, index=ops.index(current_op), key=f"op_{i}")
                
            with f_col3:
                # Input mode based on type
                if 'int' in col_type or 'numeric' in col_type or 'real' in col_type or 'float' in col_type:
                    # Need a fallback if the value cannot be cast to float
                    try:
                        val_placeholder = float(_filter['value']) if _filter['value'] != "" else 0.0
                    except ValueError:
                        val_placeholder = 0.0
                    sel_val = st.number_input(f"Value", value=val_placeholder, key=f"val_{i}")
                else:
                    sel_val = st.text_input(f"Value", value=str(_filter['value']), key=f"val_{i}")
                    
            with f_col4:
                st.markdown("<br>", unsafe_allow_html=True) # visual alignment
                if st.button("❌", key=f"del_{i}"):
                    filters_to_remove.append(i)
                    
            # Save to updating conditions list
            updated_conditions.append({
                "column": sel_col, 
                "operator": sel_op, 
                "value": sel_val, 
                "type": col_type
            })

            repr_conditions.append({
                "column": f'"{sel_col}"', 
                "operator": sel_op, 
                "value": sel_val, 
                "type": col_type
            })
            
        # Remove flagged filters and update session state
        if filters_to_remove:
            for idx in reversed(filters_to_remove):
                updated_conditions.pop(idx)
                repr_conditions.pop(idx)
            st.session_state.filters = updated_conditions
            st.session_state.repr_filters = repr_conditions
            st.rerun()
        else:
            # Sync the session state with UI changes
            st.session_state.filters = updated_conditions
            st.session_state.repr_filters = repr_conditions
            
        st.markdown("---")
        
        # 4. EXECUTE
        
        if st.button("🚀 Get Table", type="primary", use_container_width=True):
            with st.spinner("Fetching data from PostgreSQL..."):
                # Prepare date inputs
                active_date_col = date_column if date_column != "None" else None
                # Formatting as string for the DB query 
                str_start_date = start_date.strftime("%Y-%m-%d") if active_date_col else None
                str_end_date = end_date.strftime("%Y-%m-%d") if active_date_col else None
                
                # Format condition values (like converting IN strings to tuples/lists)
                final_conditions = []
                repr_final_conditions = []
                for c in updated_conditions:
                    if c['operator'] == 'IN' and isinstance(c['value'], str):
                        # Assuming user inputs comma separated string like: a,b,c
                        c['value'] = tuple([x.strip() for x in c['value'].split(',') if x.strip()])
                    final_conditions.append(c)
                
                for c in repr_conditions:
                    if c['operator'] == 'IN' and isinstance(c['value'], str):
                        # Assuming user inputs comma separated string like: a,b,c
                        c['value'] = tuple([x.strip() for x in c['value'].split(',') if x.strip()])
                    repr_final_conditions.append(c)
                
                # Build and execute
                q, p = engine.build_dynamic_query(
                    table_name=table_name,
                    date_column=active_date_col,
                    start_date=str_start_date,
                    end_date=str_end_date,
                    conditions=final_conditions
                )

                repr_q, _ = engine.build_dynamic_query(
                    table_name=table_name,
                    date_column=active_date_col,
                    start_date=str_start_date,
                    end_date=str_end_date,
                    conditions=repr_final_conditions
                )  

                df = engine.execute_query(query=q, params=tuple(p))
                used_query = q

                if df.empty: 
                    st.toast(
                        "Query returned no rows, trying alternative query",
                        icon="⚠️"
                    )
                    
                    df = engine.execute_query(query=repr_q, params=tuple(p))
                    df.head(10)
                    used_query = repr_q


                with st.expander("Show Generated SQL"):
                    st.code(
                        f"Generated Query:\n{used_query}\n\nParams: {p}",
                        language="sql"
                    )


                if df.empty:
                    st.info("No data returned from query.")
                else:
                    st.success(f"Successfully retrieved {len(df)} rows!")
                    st.caption("Data only shows first 50 rows")
                    st.dataframe(df.head(50), use_container_width=True)

                    csv = df.to_csv(index=False).encode("utf-8")
                    
                    op1, op2 = st.columns(2)
                    with op1 :
                        st.download_button(
                            label="📥 Download Data as CSV",
                            data=csv,
                            file_name=f"{table_name}_extract.csv",
                            mime="text/csv",
                            use_container_width=True
                        )
                    with op2 :
                        st.button(
                            label="📤 Upload To Spreadsheet",
                            use_container_width=True,
                            on_click=lambda: sheetdrive.upload_new_gsheet(dataframe=df)
                        )
